# For a VPS where nginx already owns ports 80 and 443. Route by TLS server name without decrypting.
# The relay then runs with "host": "127.0.0.1", "httpsPort": 9443, "httpPort": 9080, and nginx's own
# https sites move to 127.0.0.1:8443.

stream {  # top level of nginx.conf, next to `http`
    map $ssl_preread_server_name $loom_backend {
        relay.furevikstrand.cloud                   127.0.0.1:9443;
        ~^[a-z0-9-]+\.relay\.furevikstrand\.cloud$  127.0.0.1:9443;
        default                                     127.0.0.1:8443;
    }
    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $loom_backend;
        proxy_connect_timeout 5s;
    }
}

http {
    # ACME challenges for hub names go to the relay, which forwards them to the hub; the rest redirects.
    server {
        listen 80;
        listen [::]:80;
        server_name ~^[a-z0-9-]+\.relay\.furevikstrand\.cloud$;
        location /.well-known/acme-challenge/ {
            proxy_pass http://127.0.0.1:9080;
            proxy_set_header Host $host;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }
}

# Behind nginx the relay sees 127.0.0.1 for every visitor, so its per-address limits apply to all
# visitors together, and hubs see 127.0.0.1 as the visitor address.
