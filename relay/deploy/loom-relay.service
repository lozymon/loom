[Unit]
Description=Loom relay (TLS passthrough for dial-out Loom hubs)
After=network-online.target
Wants=network-online.target

[Service]
User=loom-relay
Group=loom-relay
ExecStart=/usr/bin/node /opt/loom-relay/loom-relay.mjs run --config /etc/loom-relay/relay.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=loom-relay
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
